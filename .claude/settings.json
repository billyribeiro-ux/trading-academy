{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(pnpm install)",
			"Bash(pnpm dev)",
			"Bash(pnpm verify)",
			"Bash(pnpm check)",
			"Bash(pnpm lint)",
			"Bash(pnpm format)",
			"Bash(pnpm build)",
			"Bash(pnpm test:unit *)",
			"Bash(pnpm test:e2e *)",
			"Bash(pnpm exec prettier *)",
			"Bash(git status)",
			"Bash(git diff *)",
			"Bash(git log *)",
			"Bash(git branch *)",
			"Bash(git switch *)",
			"Bash(git add *)",
			"Bash(gh pr view *)",
			"Bash(gh pr checks *)"
		],
		"ask": ["Bash(git commit *)", "Bash(git push *)", "Bash(pnpm add *)", "Bash(gh pr create *)"],
		"deny": [
			"Read(./.env)",
			"Read(./.env.*)",
			"Bash(npm *)",
			"Bash(npx *)",
			"Bash(yarn *)",
			"Bash(rm -rf *)",
			"Bash(git push --force *)",
			"Bash(git push -f *)",
			"Bash(git reset --hard *)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-file.mjs\""
					}
				]
			}
		]
	},
	"extraKnownMarketplaces": {
		"svelte": {
			"source": {
				"source": "github",
				"repo": "sveltejs/ai-tools"
			}
		}
	},
	"enabledPlugins": {
		"svelte@svelte": true
	}
}
