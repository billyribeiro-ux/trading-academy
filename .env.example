# Copy to .env and adjust. Never commit .env.

# Public origin of the site, used for canonical URLs. No trailing slash.
SITE_URL=http://localhost:5173

# PostgreSQL connection string. Matches the local database in compose.yaml.
DATABASE_URL=postgres://root:mysecretpassword@localhost:5432/local

# Signs session cookies. At least 32 characters. Generate a new one for every environment:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-the-output-of-openssl-rand-base64-32
